{
  "name": "ratchet-extension",
  "version": "1.0.0",
  "description": "Ratchet Privacy Shield Chrome Extension",
  "scripts": {
    "dev": "vite",
    "build:trie": "node scripts/build-trie.mjs",
    "build": "npm run build:trie && tsc && vite build",
    "build:test": "npm run build:trie && tsc && vite build --mode test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
